# Zoho Projects OAuth ("Self Client") credentials - generate at
# https://api-console.zoho.com (see README > Zoho Projects OAuth Setup).
# These MUST stay server-side only; the frontend never sees them.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho data center hosting your Projects portal. Defaults shown are for .com;
# switch to accounts.zoho.eu / projectsapi.zoho.eu (or .in / .com.au / .jp)
# if your portal is on another data center.
ZOHO_ACCOUNTS_DC=https://accounts.zoho.com
ZOHO_API_DC=https://projectsapi.zoho.com

# The Zoho Projects portal ID that stores all CareFlow data.
ZOHO_PORTAL_ID=935571358

# Secret used to sign CareFlow's own demo-login JWTs. Change for any
# non-throwaway deployment.
JWT_SECRET=careflow-dev-secret-change-me

# Shared password for all demo accounts (see README > Demo Credentials).
DEMO_PASSWORD=CareFlow@2026

# How long (ms) list responses are cached in-memory before re-fetching from
# Zoho Projects. Lower = fresher data, higher = fewer API calls.
CACHE_TTL_MS=15000

# Local-only: port the Express server listens on (Catalyst sets
# X_ZOHO_CATALYST_LISTEN_PORT automatically in production).
PORT=9000
